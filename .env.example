# 本番・プレビューで使う環境変数の一覧です。実際の値は、Vercel の Settings → Environment Variables に入れてください。
# このファイルには、実際の値を書かないでください（リポジトリに公開されます）。

# --- 公開URL（ふだんは入れなくてよい） -------------------------------------
# Vercel では、本番のドメインが自動で使われます。独自ドメインを使うときに、https://example.com/ の形で入れると、それが優先されます。
# SITE_URL=

# --- 有料版（Stripe）。有料版を動かすときに必要 --------------------------
# Stripe ダッシュボード → 開発者 → APIキー（テストモードは sk_test_…、本番は sk_live_…）
STRIPE_SECRET_KEY=
# 商品カタログで作った、月額の価格のID（price_…）
STRIPE_PRICE_ID=
# 有料の枠を閉じて、有料版を始めるスイッチ（ビルドのときに読まれる）。1 にすると、決済の設定があるサイトで、有料の枠が閉じる。
# 入れない（または 1 以外）のあいだは、すべて開いたまま。入れたあとは、再デプロイが必要。
VITE_BILLING=
# 購入状態の署名に使う、長いランダムな文字列（32文字以上。例：openssl rand -hex 32 の結果）
ENTITLEMENT_SECRET=
